# ============================================================
# Bulkaroma Price Intelligence — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ============================================================

# ------------------------------------------------------------
# FRONTEND (Vite) — SAFE FOR BROWSER
# Only VITE_ prefixed variables are exposed to the browser.
# ------------------------------------------------------------

# Your Supabase project URL (from Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase Publishable Key (from Project Settings > API)
# This key is safe to use in the browser. It respects Row Level Security.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable__your_key_here

# ------------------------------------------------------------
# BACKEND (Node.js / Express) — SERVER ONLY
# These variables MUST NOT be prefixed with VITE_.
# NEVER put these in frontend code.
# ------------------------------------------------------------

# Your Supabase project URL (same as above, for the server)
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase Secret Key (from Project Settings > API)
# WARNING: This key bypasses Row Level Security.
# SERVER ONLY — NEVER expose this to the browser.
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# ------------------------------------------------------------
# DATABASE — SERVER ONLY
# Direct PostgreSQL connection string for migrations and backend.
# WARNING: Contains your database password.
# SERVER ONLY — NEVER expose this to the browser.
# ------------------------------------------------------------

# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Note: If your password contains special characters (e.g. @), URL-encode them.
# @ becomes %40, # becomes %23, etc.
SUPABASE_DB_URL=postgresql://postgres:your_password@db.xxxxxxxxxxxxxxxxxxxx.supabase.co:5432/postgres

# ------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------

# Backend server port
PORT=3001

# Node environment: development | production | test
NODE_ENV=development

# Scraper cache TTL in seconds (default: 3600 = 1 hour)
SCRAPER_CACHE_TTL=3600

# Max concurrent scraper requests per supplier
SCRAPER_CONCURRENCY=3

# Request delay between pages in milliseconds
SCRAPER_REQUEST_DELAY_MS=1500

# Currency API provider (currently: exchangerate-api | open-exchange-rates)
CURRENCY_API_PROVIDER=exchangerate-api

# Exchange rate API key (get a free key at exchangerate-api.com)
CURRENCY_API_KEY=your_exchange_rate_api_key

# Supabase Storage bucket for Excel exports
EXPORT_BUCKET=exports

# Admin email for Supabase Auth
ADMIN_EMAIL=admin@yourdomain.com
